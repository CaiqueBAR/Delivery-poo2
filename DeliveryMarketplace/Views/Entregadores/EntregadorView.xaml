<UserControl x:Class="DeliveryMarketplace.Views.Entregadores.EntregadorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TxtNome" Style="{StaticResource SectionTitleText}" FontSize="18" />
                    <TextBlock x:Name="TxtSituacao" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Atualizar_Click" />
                    <Button x:Name="BtnDisponivel" Style="{StaticResource PrimaryButton}" Click="Disponivel_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel x:Name="Indicadores" />

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Minhas entregas em andamento" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                <DataGrid x:Name="GradeMinhas">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding Codigo}" Width="70" />
                        <DataGridTextColumn Header="Retirar em" Binding="{Binding RestauranteNome}" Width="*" />
                        <DataGridTextColumn Header="Entregar em" Binding="{Binding EnderecoEntrega}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusTexto}" Width="150" />
                        <DataGridTextColumn Header="Pagamento" Binding="{Binding PagamentoTexto}" Width="150" />
                        <DataGridTemplateColumn Header="Ações" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Retirei" Tag="{Binding}" Style="{StaticResource SmallButton}" Click="Retirada_Click" />
                                        <Button Content="Entreguei" Tag="{Binding}" Style="{StaticResource SmallButton}" Click="Entrega_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Entregas disponíveis" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="Pedidos aceitos pelos restaurantes que ainda não têm entregador. Você recebe a taxa de entrega."
                           Style="{StaticResource CaptionText}" Margin="0,2,0,12" />
                <DataGrid x:Name="GradeDisponiveis">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding Codigo}" Width="70" />
                        <DataGridTextColumn Header="Restaurante" Binding="{Binding RestauranteNome}" Width="*" />
                        <DataGridTextColumn Header="Destino" Binding="{Binding EnderecoEntrega}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusTexto}" Width="150" />
                        <DataGridTextColumn Header="Você ganha" Binding="{Binding TaxaEntrega, StringFormat=C}" Width="90" />
                        <DataGridTemplateColumn Header="Ação" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Aceitar" Tag="{Binding}" Style="{StaticResource SmallButton}" Click="Aceitar_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Histórico" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                <DataGrid x:Name="GradeHistorico" MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding Codigo}" Width="70" />
                        <DataGridTextColumn Header="Data" Binding="{Binding EntregueEm, StringFormat=dd/MM HH:mm}" Width="100" />
                        <DataGridTextColumn Header="Restaurante" Binding="{Binding RestauranteNome}" Width="*" />
                        <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" />
                        <DataGridTextColumn Header="Ganho" Binding="{Binding TaxaEntrega, StringFormat=C}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
