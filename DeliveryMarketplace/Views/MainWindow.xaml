<Window x:Class="DeliveryMarketplace.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeliveryMarketplace"
        Width="1280" Height="800" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Menu lateral ===== -->
        <Border x:Name="Menu" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="16,24">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,28">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource HeroGradientBrush}">
                        <TextBlock Text="&#xE7BF;" Style="{StaticResource IconText}" Foreground="White" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Delivery" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Marketplace" Foreground="{StaticResource SidebarTextBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Usuário logado + sair -->
                <StackPanel DockPanel.Dock="Bottom" Margin="6,16,6,0">
                    <TextBlock x:Name="TxtUsuario" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtPerfil" Foreground="{StaticResource SidebarTextBrush}" FontSize="12" Margin="0,2,0,10" />
                    <Button Content="Sair" Style="{StaticResource NavButton}" Click="Sair_Click" />
                    <TextBlock Text="v1.0 · projeto acadêmico · dados fictícios" Foreground="{StaticResource SidebarTextBrush}"
                               FontSize="11" Opacity="0.7" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="MENU" Foreground="{StaticResource SidebarTextBrush}" FontSize="11"
                               FontWeight="SemiBold" Opacity="0.7" Margin="6,0,0,10" />
                    <StackPanel x:Name="ItensMenu" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Conteúdo ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="Cabecalho" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="32,20">
                <StackPanel>
                    <TextBlock x:Name="TxtTitulo" Style="{StaticResource PageTitleText}" />
                    <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="Conteudo" Margin="32,24" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
