<UserControl x:Class="DeliveryMarketplace.Views.Restaurantes.CardapioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Produtos" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                <DataGrid x:Name="Grade" SelectionChanged="Grade_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Categoria" Binding="{Binding CategoriaNome}" Width="130" />
                        <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*" />
                        <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C}" Width="90" />
                        <DataGridTextColumn Header="Situação" Binding="{Binding SituacaoTexto}" Width="100" />
                        <DataGridTemplateColumn Header="Ação" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Disponível?" Tag="{Binding}" Style="{StaticResource SmallButton}" Click="Disponibilidade_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Clique em um produto para editá-lo no formulário ao lado." Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock x:Name="TxtFormTitulo" Text="Novo produto" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CmbCategoria" />
                    <TextBlock Text="Nome" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtNome" />
                    <TextBlock Text="Descrição" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtDescricao" />
                    <TextBlock Text="Preço (R$)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtPreco" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Click="Salvar_Click" />
                        <Button Content="Novo" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Limpar_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Nova categoria" Style="{StaticResource SectionTitleText}" />
                    <TextBox x:Name="TxtCategoria" Margin="0,10,0,0" />
                    <Button Content="Adicionar categoria" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Click="Categoria_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
