<UserControl x:Class="DeliveryMarketplace.Views.Clientes.MeusPedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Histórico de pedidos" Style="{StaticResource SectionTitleText}" />
                <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="Atualizar_Click" />
            </Grid>
            <DataGrid x:Name="Grade">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pedido" Binding="{Binding Codigo}" Width="70" />
                    <DataGridTextColumn Header="Data" Binding="{Binding CriadoEm, StringFormat=dd/MM HH:mm}" Width="90" />
                    <DataGridTextColumn Header="Restaurante" Binding="{Binding RestauranteNome}" Width="150" />
                    <DataGridTextColumn Header="Itens" Binding="{Binding ItensTexto}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusTexto}" Width="150" />
                    <DataGridTextColumn Header="Pagamento" Binding="{Binding PagamentoTexto}" Width="160" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="85" />
                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Cancelar" Tag="{Binding}" Style="{StaticResource DangerSmallButton}" Click="Cancelar_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="O cancelamento só é possível enquanto o restaurante não aceitar o pedido. Pagamentos aprovados são estornados."
                       Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
