<UserControl x:Class="DeliveryMarketplace.Views.Admin.AdminPainelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <WrapPanel x:Name="Indicadores" />

        <Border Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock Text="Últimos pedidos" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                <DataGrid x:Name="Grade" MaxHeight="420">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding Codigo}" Width="80" />
                        <DataGridTextColumn Header="Data" Binding="{Binding CriadoEm, StringFormat=dd/MM HH:mm}" Width="100" />
                        <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" />
                        <DataGridTextColumn Header="Restaurante" Binding="{Binding RestauranteNome}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusTexto}" Width="160" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
