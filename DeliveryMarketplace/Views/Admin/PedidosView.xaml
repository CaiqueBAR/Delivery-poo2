<UserControl x:Class="DeliveryMarketplace.Views.Admin.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Filtrar por status:" VerticalAlignment="Center" Style="{StaticResource BodyText}" Margin="0,0,10,0" />
                <ComboBox x:Name="CmbStatus" Width="220" SelectionChanged="Filtro_Changed" />
            </StackPanel>
            <DataGrid x:Name="Grade">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pedido" Binding="{Binding Codigo}" Width="70" />
                    <DataGridTextColumn Header="Data" Binding="{Binding CriadoEm, StringFormat=dd/MM HH:mm}" Width="90" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" />
                    <DataGridTextColumn Header="Restaurante" Binding="{Binding RestauranteNome}" Width="*" />
                    <DataGridTextColumn Header="Entregador" Binding="{Binding EntregadorNome}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusTexto}" Width="150" />
                    <DataGridTextColumn Header="Pagamento" Binding="{Binding PagamentoTexto}" Width="170" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>
