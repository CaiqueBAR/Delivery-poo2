@startuml
skinparam classAttributeIconSize 0

abstract class Produto {
  -Id : int
  -Nome : string
  -Descricao : string
  -Preco : decimal
  -TempoPreparoMin : int
  +ExibirInformacoes() : string
}

interface IPreparacao {
  +Preparar() : string
}

class Prato {
  -TipoCozinha : string
  -Tamanho : string
  -Ingredientes : string
}

class Bebida {
  -VolumeMl : int
  -Gelada : bool
  -Tipo : string
}

class Restaurante {
  -Id : int
  -Nome : string
  -Endereco : string
  -Telefone : string
  -Categoria : string
  +AdicionarProduto()
  +RemoverProduto()
  +ListarProdutos()
}

class Pedido {
  -Id : int
  -DataPedido : DateTime
  -Status : PedidoStatus
  -ValorTotal : decimal
  -ClienteNome : string
  -EnderecoEntrega : string
  +CalcularTotal() : decimal
  +AlterarStatus()
  +FinalizarPedido()
}

class ItemDePedido {
  -Id : int
  -Quantidade : int
  -Subtotal : decimal
  +CalcularSubtotal()
}

class Cupom
class Usuario
class Cliente
class Entregador
class AvaliacaoProduto

Produto <|-- Prato
Produto <|-- Bebida
IPreparacao <|.. Prato
Restaurante "1" o-- "*" Produto
Pedido "1" o-- "*" ItemDePedido
ItemDePedido "*" --> "1" Produto
Cliente "1" --> "*" Pedido
Produto "1" --> "*" AvaliacaoProduto
Usuario "1" --> "0..1" Cliente

@enduml
