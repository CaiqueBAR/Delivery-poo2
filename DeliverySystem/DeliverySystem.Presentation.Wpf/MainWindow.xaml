<Window x:Class="DeliverySystem.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DeliverySystem.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="DeliverySystem"
        Height="900"
        Width="1440"
        MinHeight="780"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" FontSize="22" FontWeight="Bold">
                    <Run Text="i" Foreground="{StaticResource AccentBrush}" />
                    <Run Text="food" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>

                <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavTabViewModel}">
                            <Button Padding="10,6"
                                    Margin="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Height="2"
                                            Margin="0,6,0,0"
                                            Background="{StaticResource AccentBrush}"
                                            Opacity="{Binding IsSelected, Converter={StaticResource BooleanToOpacityConverter}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="3" VerticalAlignment="Center" Margin="24,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="44"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Width="44"
                                Height="44"
                                Margin="10,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding SearchCommand}"
                                Content="🔎" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="12,8" Background="#F3F4F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="Av. Porto Seguro, 1097" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <Border Margin="14,0,0,0" Padding="12,8" Background="#F3F4F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="999">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Cart.Total, StringFormat=R$ {0:0.00}}" FontWeight="SemiBold" />
                            <TextBlock Margin="8,0,8,0" Text="|" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Cart.ItemsCount, StringFormat={}{0} itens}" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Margin="24" Padding="0">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
