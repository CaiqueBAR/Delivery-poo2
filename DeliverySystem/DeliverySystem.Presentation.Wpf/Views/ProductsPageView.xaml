<UserControl x:Class="DeliverySystem.Presentation.Wpf.Views.ProductsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeliverySystem.Presentation.Wpf.ViewModels">
    <Grid>
        <StackPanel>
            <Border Padding="16" CornerRadius="18" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="44"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox Grid.Column="2"
                              Height="44"
                              Background="#F3F4F6"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              ItemsSource="{Binding Restaurantes}"
                              SelectedItem="{Binding RestauranteSelecionado}"
                              DisplayMemberPath="Nome" />

                    <Button Grid.Column="4"
                            Height="44"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SearchCommand}"
                            Content="Buscar" />
                </Grid>
            </Border>

            <Border Margin="0,14,0,0"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Visibility="Visible">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,16,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Itens}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="260" ItemHeight="220" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProductCardViewModel}">
                                <Button Margin="0,0,16,16"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.OpenProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Padding="14"
                                            CornerRadius="18"
                                            Background="{StaticResource SurfaceBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.25" />
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Border CornerRadius="14" Background="#0B1220" />
                                                <Image x:Name="CardImage"
                                                       Margin="0"
                                                       Stretch="UniformToFill"
                                                       Source="{Binding ImagemPath, Converter={StaticResource ImagePathToImageSourceConverter}}" />
                                                <TextBlock Text="Sem foto"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=CardImage, Path=Source}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border DockPanel.Dock="Right" Padding="10,4" Background="{StaticResource AccentBrush}" CornerRadius="10">
                                                        <TextBlock Text="{Binding Preco, StringFormat=R$ {0:0.00}}" FontWeight="SemiBold" />
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Margin="0,8,0,0"
                                                           Text="{Binding Descricao}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,6,0,0" Text="{Binding Tipo}" Foreground="#2563EB" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="14"
                           Visibility="Collapsed"
                           Text="Nenhum item encontrado.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Itens.Count}" Value="0" />
                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Background="#CCFFFFFF"
                        CornerRadius="18"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" Height="8" IsIndeterminate="True" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="Carregando..."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
