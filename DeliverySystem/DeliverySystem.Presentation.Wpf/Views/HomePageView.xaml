<UserControl x:Class="DeliverySystem.Presentation.Wpf.Views.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeliverySystem.Presentation.Wpf.ViewModels">
    <StackPanel>
        <Border Background="#2E7D32" CornerRadius="12" Padding="12">
            <DockPanel>
                <TextBlock Text="{Binding PromoBarText}" Foreground="White" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right" Text="˅" Foreground="White" />
            </DockPanel>
        </Border>

        <Border Margin="0,16,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
            <StackPanel>
                <TextBlock Text="Conheça as categorias" FontSize="18" FontWeight="SemiBold" />
                <ScrollViewer Margin="0,14,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryChipViewModel}">
                                <StackPanel Margin="0,0,18,0" Width="76">
                                    <Grid Height="58" Width="58" HorizontalAlignment="Center">
                                        <Border CornerRadius="29" Background="#F3F4F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                        <Image Stretch="Uniform"
                                               Margin="12"
                                               Source="{Binding IconPath, Converter={StaticResource ImagePathToImageSourceConverter}}" />
                                    </Grid>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding Nome}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <ScrollViewer Margin="0,16,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Banners}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BannerViewModel}">
                        <Border Width="310" Height="120" Margin="0,0,14,0" CornerRadius="14" Background="{StaticResource AccentBrush}">
                            <Grid>
                                <Image Opacity="0.18" Stretch="UniformToFill" Source="{Binding ImagePath, Converter={StaticResource ImagePathToImageSourceConverter}}" />
                                <Grid Margin="16">
                                    <TextBlock Text="{Binding Titulo}" Foreground="White" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Margin="0,22,0,0">
            <TextBlock Text="Desconto até 35% OFF" FontSize="18" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Right" Text="Ver mais" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
        </DockPanel>

        <ScrollViewer Margin="0,14,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Ofertas}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProductCardViewModel}">
                        <Button Width="210"
                                Margin="0,0,14,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.OpenProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                                <StackPanel>
                                    <Grid Height="98">
                                        <Border CornerRadius="12" Background="#F3F4F6" />
                                        <Image Stretch="UniformToFill" Source="{Binding ImagemPath, Converter={StaticResource ImagePathToImageSourceConverter}}" />
                                    </Grid>
                                    <TextBlock Margin="0,10,0,0" Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Preco, StringFormat=R$ {0:0.00}}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
