<UserControl x:Class="DeliverySystem.Presentation.Wpf.Views.PlaceholderPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeliverySystem.Presentation.Wpf.ViewModels">
    <Border Padding="26" CornerRadius="22" Background="{StaticResource SurfaceBrush}">
        <StackPanel>
            <TextBlock Text="{Binding Titulo}" FontSize="26" FontWeight="Bold" />
            <TextBlock Margin="0,10,0,0" Text="{Binding Texto}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
