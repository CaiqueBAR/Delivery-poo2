<UserControl x:Class="DeliverySystem.Presentation.Wpf.Views.CartPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeliverySystem.Presentation.Wpf.ViewModels"
             xmlns:services="clr-namespace:DeliverySystem.Presentation.Wpf.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="18" CornerRadius="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="Carrinho" FontSize="20" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Cart.ItemsCount, StringFormat={}{0} itens}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,14,0,14" Padding="18" CornerRadius="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Visibility="Visible">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#991B1B" TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Itens"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type services:CartItem}">
                                        <Border Margin="0,0,0,12" Padding="12" CornerRadius="14" Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="72" Height="56">
                                                    <Border CornerRadius="10" Background="#F3F4F6" />
                                                    <Image Stretch="UniformToFill" Source="{Binding ImagePath, Converter={StaticResource ImagePathToImageSourceConverter}}" />
                                                </Grid>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding UnitPrice, StringFormat=R$ {0:0.00}}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Text="{Binding Subtotal, StringFormat=R$ {0:0.00}}"
                                                               FontWeight="SemiBold" />
                                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Width="32"
                                                                Height="32"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                Content="−"
                                                                Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Width="36"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   Text="{Binding Quantity}" />
                                                        <Button Width="32"
                                                                Height="32"
                                                                Margin="8,0,0,0"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                Content="+"
                                                                Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Margin="10,0,0,0"
                                                                Height="32"
                                                                Padding="12,0"
                                                                Background="Transparent"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="Remover" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       Visibility="Collapsed"
                                       Text="Seu carrinho está vazio.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cart.ItemsCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="18" CornerRadius="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Total" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding Cart.Total, StringFormat=R$ {0:0.00}}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,12,0"
                            Padding="16,10"
                            Background="Transparent"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Command="{Binding ClearCommand}">
                        <TextBlock Text="Limpar" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CheckoutCommand}"
                            Content="Finalizar" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
