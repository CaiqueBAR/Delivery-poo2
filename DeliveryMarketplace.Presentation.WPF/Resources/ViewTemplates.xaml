<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DeliveryMarketplace.Presentation.WPF.ViewModels"
                    xmlns:views="clr-namespace:DeliveryMarketplace.Presentation.WPF.Views">

    <!--
        Mapeamento ViewModel -> View (navegação "ViewModel-first").
        Quando o ContentControl da janela principal recebe um ViewModel,
        o WPF escolhe automaticamente a View correspondente.
    -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <views:HomeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SystemStatusViewModel}">
        <views:SystemStatusView />
    </DataTemplate>

</ResourceDictionary>
