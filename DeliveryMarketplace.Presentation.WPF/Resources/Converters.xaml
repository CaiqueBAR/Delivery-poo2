<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DeliveryMarketplace.Presentation.WPF.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Verde para verdadeiro, cinza para falso (ex.: fases concluídas) -->
    <conv:BoolToBrushConverter x:Key="BoolToSuccessBrush"
                               TrueBrush="{StaticResource SuccessBrush}"
                               FalseBrush="{StaticResource BorderBrush}" />

    <!-- Verde para verdadeiro, laranja para falso (ex.: arquivo ainda não criado) -->
    <conv:BoolToBrushConverter x:Key="BoolToStatusBrush"
                               TrueBrush="{StaticResource SuccessBrush}"
                               FalseBrush="{StaticResource WarningBrush}" />

</ResourceDictionary>
