<Window x:Class="DeliveryMarketplace.Presentation.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DeliveryMarketplace.Presentation.WPF.ViewModels"
        xmlns:nav="clr-namespace:DeliveryMarketplace.Presentation.WPF.Navigation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="DeliveryMarketplace"
        Width="1240" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Aparência de cada item do menu lateral -->
        <DataTemplate DataType="{x:Type nav:NavigationItem}">
            <Button x:Name="NavButton"
                    Style="{StaticResource NavButton}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" FontSize="16" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="NavButton" Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter TargetName="NavButton" Property="Foreground" Value="White" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="16,24">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,32">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource HeroGradientBrush}">
                        <TextBlock Text="&#xE7BF;" Style="{StaticResource IconText}" Foreground="White" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Delivery" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Marketplace" Foreground="{StaticResource SidebarTextBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Rodapé -->
                <StackPanel DockPanel.Dock="Bottom" Margin="6,16,6,0">
                    <TextBlock Text="{Binding VersionLabel}" Foreground="{StaticResource SidebarTextBrush}" FontSize="12" />
                    <TextBlock Text="Projeto acadêmico · dados fictícios" Foreground="{StaticResource SidebarTextBrush}"
                               FontSize="11" Opacity="0.7" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Menu -->
                <StackPanel>
                    <TextBlock Text="MENU" Foreground="{StaticResource SidebarTextBrush}" FontSize="11"
                               FontWeight="SemiBold" Opacity="0.7" Margin="6,0,0,10" />
                    <ItemsControl ItemsSource="{Binding MenuItems}" Focusable="False" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Conteúdo ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho da página -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="32,20">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentViewModel.Title}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{Binding CurrentViewModel.Subtitle}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Página atual (View escolhida pelos DataTemplates de Resources/ViewTemplates.xaml) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentViewModel}" Margin="32,24" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
