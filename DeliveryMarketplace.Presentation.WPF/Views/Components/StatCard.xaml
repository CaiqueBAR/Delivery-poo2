<UserControl x:Class="DeliveryMarketplace.Presentation.WPF.Views.Components.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Componente reutilizável de indicador (usado nos dashboards das próximas fases) -->
    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}">
                <TextBlock Text="{Binding Icon, ElementName=Root}" Style="{StaticResource IconText}" FontSize="20"
                           Foreground="{StaticResource PrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource CaptionText}" />
                <TextBlock Text="{Binding Value, ElementName=Root}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,2" />
                <TextBlock Text="{Binding Caption, ElementName=Root}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
