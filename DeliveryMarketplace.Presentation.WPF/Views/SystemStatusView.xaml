<UserControl x:Class="DeliveryMarketplace.Presentation.WPF.Views.SystemStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DeliveryMarketplace.Presentation.WPF.ViewModels"
             xmlns:components="clr-namespace:DeliveryMarketplace.Presentation.WPF.Views.Components"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SystemStatusViewModel}"
             d:DesignWidth="960">
    <StackPanel>

        <!-- Título da seção + ação -->
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Diagnóstico da configuração" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="O teste de conexão usa um banco SQLite em memória; o arquivo definitivo só é criado na Fase 2."
                           Style="{StaticResource BodyText}" Margin="0,4,180,0" />
            </StackPanel>
            <Button Content="Verificar novamente" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Alerta de erro -->
        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="10" Padding="16,12" Margin="0,16,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- Indicadores -->
        <UniformGrid Columns="3" Margin="0,16,0,0">
            <components:StatCard Margin="0,0,8,0" Icon="&#xE9D9;" Title="Conexão SQLite"
                                 Value="{Binding ConexaoTexto}" Caption="SELECT sqlite_version() em memória" />
            <components:StatCard Margin="8,0" Icon="&#xE7B8;" Title="Versão do SQLite"
                                 Value="{Binding VersaoSqlite}" Caption="{Binding Provedor}" />
            <components:StatCard Margin="8,0,0,0" Icon="&#xE950;" Title="Runtime"
                                 Value="{Binding Runtime}" Caption="WPF · MVVM · Microsoft.Extensions.Hosting" />
        </UniformGrid>

        <!-- Arquivo do banco -->
        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Arquivo do banco (delivery.db)" Style="{StaticResource SectionTitleText}" />
                <TextBox Text="{Binding CaminhoArquivo, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" FontFamily="Consolas" FontSize="13" Margin="0,10,0,0"
                         Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding ArquivoExiste, Converter={StaticResource BoolToStatusBrush}}" />
                    <TextBlock Text="{Binding ArquivoTexto}" Style="{StaticResource BodyText}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Camadas -->
        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Camadas da solução" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Camadas}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Projeto}" FontFamily="Consolas" FontSize="13"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Responsabilidade}" Style="{StaticResource BodyText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
