<UserControl x:Class="DeliveryMarketplace.Presentation.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DeliveryMarketplace.Presentation.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             d:DesignWidth="960">
    <StackPanel>

        <!-- Destaque -->
        <Border CornerRadius="16" Background="{StaticResource HeroGradientBrush}" Padding="32,28">
            <Grid>
                <StackPanel Margin="0,0,140,0">
                    <TextBlock Text="Bem-vindo ao DeliveryMarketplace" Foreground="White" FontSize="26" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Foreground="White" Opacity="0.92" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="Marketplace de delivery que conecta clientes, restaurantes, entregadores e administradores. Projeto acadêmico com dados fictícios e pagamentos simulados." />
                    <Button Content="Ver status do sistema" Command="{Binding OpenStatusCommand}"
                            Style="{StaticResource LightButton}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                </StackPanel>
                <TextBlock Text="&#xE806;" Style="{StaticResource IconText}" FontSize="104" Foreground="White" Opacity="0.25"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Perfis -->
        <TextBlock Text="Perfis de acesso" Style="{StaticResource SectionTitleText}" Margin="0,28,0,12" />
        <ItemsControl ItemsSource="{Binding Perfis}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Width="236" Margin="0,0,16,16">
                        <StackPanel>
                            <Border Style="{StaticResource IconTile}">
                                <TextBlock Text="{Binding Icone}" Style="{StaticResource IconText}" FontSize="20"
                                           Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Nome}" Style="{StaticResource SectionTitleText}" Margin="0,14,0,6" />
                            <TextBlock Text="{Binding Descricao}" Style="{StaticResource BodyText}" Height="58" />
                            <Border Style="{StaticResource BadgeBorder}" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource CaptionText}">
                                    <Run Text="Disponível na" />
                                    <Run Text="{Binding Disponibilidade, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Roteiro -->
        <TextBlock Text="Roteiro de desenvolvimento" Style="{StaticResource SectionTitleText}" Margin="0,12,0,12" />
        <Border Style="{StaticResource CardBorder}" Padding="20,12">
            <ItemsControl ItemsSource="{Binding Fases}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding Concluida, Converter={StaticResource BoolToSuccessBrush}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Rotulo}" FontSize="13" Margin="14,0,0,0"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Situacao}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
